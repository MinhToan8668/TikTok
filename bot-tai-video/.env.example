# Token bot mới, xin ở @BotFather (KHÔNG dùng chung với bot quản lý lớp)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Để trống = ai cũng dùng được. Điền chat id (cách nhau dấu phẩy) để giữ riêng cho team.
ALLOWED_IDS=5116087301,-1004298506312

# Bot API cho gửi tối đa 50 MB — để 48 cho chắc
MAX_MB=48

# Số link xử lý cùng lúc, và mỗi người phải cách nhau mấy giây
CONCURRENCY=2
COOLDOWN=3

# Chỉ cần khi tải Instagram / Facebook nội dung hạn chế.
# Xuất bằng tiện ích "Get cookies.txt LOCALLY" trên Chrome.
# COOKIES_FILE=/opt/bot-tai-video/cookies.txt
